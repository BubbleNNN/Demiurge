{
  "name": "demiurge",
  "version": "0.3.27",
  "private": true,
  "description": "An API-powered character companion and desktop pet workshop.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.cjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc -b && node --test tests/*.test.cjs",
    "setup:live2d": "node scripts/setup-live2d.cjs",
    "format": "prettier --write src electron scripts tests vite.config.ts README.md docs/*.md",
    "package:mac": "node scripts/package-desktop.cjs",
    "test:package": "node scripts/test-packaged-desktop.cjs",
    "build:desktop-helper": "node scripts/build-desktop-helper.cjs",
    "test:migration": "electron scripts/test-anime-migration-desktop.cjs",
    "test:desktop-body": "electron scripts/test-desktop-body-desktop.cjs",
    "test:sharp-pages": "electron scripts/test-sharp-pages-desktop.cjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@mozilla/readability": "^0.6.0",
    "@pixi/unsafe-eval": "6.5.10",
    "@pixiv/three-vrm": "3.4.2",
    "fflate": "0.8.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.468.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BubbleNNN/Mori.git"
  },
  "bugs": {
    "url": "https://github.com/BubbleNNN/Mori/issues"
  },
  "homepage": "https://github.com/BubbleNNN/Mori#readme"
}
